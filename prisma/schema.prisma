generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Match {
  id        Int      @id @default(autoincrement())
  map       String
  rounds    Int       @default(0)     // <-- ADICIONADO
  playedAt  DateTime  @default(now()) // <-- GARANTE QUE SEMPRE EXISTE
  players   Player[]
}

model Player {
  id       Int      @id @default(autoincrement())
  steamId  String
  name     String
  team     String   @default("UNKNOWN")  // <-- ADICIONADO

  match    Match     @relation(fields: [matchId], references: [id])
  matchId  Int

  stats    PlayerStats?
}

model PlayerStats {
  id        Int      @id @default(autoincrement())
  player    Player   @relation(fields: [playerId], references: [id])
  playerId  Int      @unique

  // Gerais
  kills      Int     @default(0)
  deaths     Int     @default(0)
  assists    Int     @default(0)
  headshots  Int     @default(0)
  damage     Int     @default(0)   // <-- ADICIONADO
  rounds     Int     @default(0)   // <-- ADICIONADO

  // CT / TR
  killsCT    Int     @default(0)
  killsTR    Int     @default(0)
  deathsCT   Int     @default(0)
  deathsTR   Int     @default(0)
  roundsCT   Int     @default(0)
  roundsTR   Int     @default(0)

  // Ratings
  adr        Float   @default(0)
  rating     Float   @default(0)   // <-- ADICIONADO
  ratingCT   Float   @default(0)
  ratingTR   Float   @default(0)

  createdAt DateTime @default(now())
}
